# Copy this file to .env for local use. Never commit the real .env file.
# The live site is static (GitHub Pages); only WEB3FORMS_ACCESS_KEY is also needed there,
# as a repository variable (see README).

# Enquiry form delivery. Free key from https://web3forms.com (enter the email address that
# should receive enquiries). The key is meant to be public: it can only email that inbox.
WEB3FORMS_ACCESS_KEY=

# Optional: one key per team inbox, so each enquiry type reaches the right person.
# Create each key at web3forms.com using that team's email. Empty = use WEB3FORMS_ACCESS_KEY.
WEB3FORMS_KEY_SALES=       # product and spare-part enquiries -> sales@arcooling.in
WEB3FORMS_KEY_SERVICES=    # service enquiries                -> services@arcooling.in
WEB3FORMS_KEY_ENQUIRY=     # "Other" / general enquiries      -> enquiry@arcooling.in

# Public address of the site (used for the sitemap, CNAME and links in WhatsApp messages).
AR_SITE_URL=https://arcooling.in

# Signs the local admin login cookie. Required for "python app.py" (32+ characters).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local admin (product/service/spare editor). Disabled until both are set; password 12+ chars.
AR_ADMIN_USERNAME=
AR_ADMIN_PASSWORD=

# 1 = auto-reload and error console when running "python app.py" locally.
AR_DEBUG=0
