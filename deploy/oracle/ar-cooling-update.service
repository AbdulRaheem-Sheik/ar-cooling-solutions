# Pulls new commits from GitHub and restarts the website if there were any (update.sh).
# Started every 5 minutes by ar-cooling-update.timer. Installed by setup.sh.
[Unit]
Description=Update AR Cooling Solutions website from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/ar-cooling/deploy/oracle/update.sh
