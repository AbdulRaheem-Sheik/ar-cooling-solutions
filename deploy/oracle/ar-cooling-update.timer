# Checks GitHub for website updates every 5 minutes (runs ar-cooling-update.service).
# Installed by setup.sh. Turn off with: sudo systemctl disable --now ar-cooling-update.timer
[Unit]
Description=Check GitHub for website updates every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
